---
import '../styles/global.css';
import UnitLightbox from '../components/UnitLightbox.astro';
import { Font } from 'astro:assets';
import { bookUrl, pad, unitPath, type Property, type PropertyUnit } from '../lib/property';
import { getSiteConfig } from '../lib/site';
import { alternatePath, localePath, strings, toLocale } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  image?: string | undefined;
  jsonLd?: Record<string, unknown> | undefined;
  property: Property;
  /** Set on a unit page: the lightbox then targets this unit only. */
  unit?: PropertyUnit;
  /** Pages that must never be indexed (404): no canonical, no language alternates. */
  noindex?: boolean;
}
const { title, description, image, jsonLd, property, unit, noindex = false } = Astro.props;
const wordmark = property.name.toLowerCase();
const siteConfig = await getSiteConfig();
const { colors } = siteConfig.design;
const style = `--ink:${colors.text};--muted:${colors.muted};--paper:${colors.background};--surface:${colors.surface};--primary:${colors.primary};--accent:${colors.accent}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const locale = toLocale(Astro.currentLocale);
const t = strings(locale);
const other = locale === 'en' ? 'sl' : 'en';
const otherPath = noindex ? localePath(other, '/') : alternatePath(Astro.url.pathname, other);
const home = localePath(locale, '/');
const absolute = (path: string) => new URL(path, Astro.site).href;
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {/* Slovenian headlines use č/š/ž, so those pages preload both files (latin + latin-ext). The Fonts API can't
        preload just one of them, and English pages never use latin-ext, so they skip preloading (no unused preload). */}
    <Font cssVariable="--font-manrope" preload={locale === 'sl'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={colors.background} />
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {(siteConfig.site.preview || noindex) && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.ogLocale} />
    {!noindex && <>
      <link rel="alternate" hreflang="en" href={absolute(alternatePath(Astro.url.pathname, 'en'))} />
      <link rel="alternate" hreflang="sl" href={absolute(alternatePath(Astro.url.pathname, 'sl'))} />
      <link rel="alternate" hreflang="x-default" href={absolute(alternatePath(Astro.url.pathname, 'en'))} />
    </>}
    <meta property="og:site_name" content={property.name} />
    <meta property="og:locale:alternate" content={strings(other).ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    {image && <meta property="og:image" content={absolute(image)} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="page" style={style}>
      <a class="skip" href="#main">{t.skip}</a>
      <header class="header wrap">
        <a class="brand" href={home} aria-label={t.home(property.name)}>
          <span>{wordmark}<span class="brand-dot">.</span></span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-open-label={t.close} data-closed-label={t.menu}>{t.menu}</button>
        <nav id="site-nav" aria-label={t.mainNav}>
          <div class="nav-drop">
            <a href={localePath(locale, '/#apartments')}>{t.apartments}</a>
            <ul>
              {property.units.map(item => <li><a href={localePath(locale, unitPath(item.id))} aria-current={item.id === unit?.id ? 'page' : undefined}>{item.name}</a></li>)}
            </ul>
          </div>
          <a href={localePath(locale, '/#place')}>{t.location}</a>
          <a class="nav-lang" href={otherPath} hreflang={other} lang={other} aria-label={strings(other).languageName}>{strings(other).languageShort}</a>
          <a class="nav-book" href={bookUrl(property, unit, locale)} target="_blank" rel="noopener noreferrer">{t.bookNow}</a>
        </nav>
      </header>
      <script is:inline>
        (() => {
          const header = document.querySelector('.header');
          const toggle = header.querySelector('.menu-toggle');
          const setOpen = (open) => {
            header.classList.toggle('open', open);
            toggle.setAttribute('aria-expanded', String(open));
            toggle.textContent = open ? toggle.dataset.openLabel : toggle.dataset.closedLabel;
          };
          toggle.addEventListener('click', () => setOpen(!header.classList.contains('open')));
          header.querySelector('nav').addEventListener('click', (event) => { if (event.target.closest('a')) setOpen(false); });
          document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setOpen(false); });
        })();
      </script>

      <main id="main">
        <slot />

        {unit && (
          <section class="practical wrap" id="arrival" aria-labelledby="arrival-title">
            <div class="practical-heading">
              <h2 id="arrival-title">{t.practicalTitle[0]}<br/>{t.practicalTitle[1]}</h2>
            </div>
            <div class="accordion">
              {property.narrative.practical.map((item, index) => (
                <details open={index === 0}>
                  <summary><span class="label">{pad(index + 1)}</span>{item.label}<span class="plus" aria-hidden="true"></span></summary>
                  <p>{item.value}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        <slot name="after-practical" />
      </main>

      <section class="cta" aria-labelledby="cta-title">
        <div class="wrap cta-inner">
          <h2 id="cta-title">{t.ctaTitle[0]}<br/>{t.ctaTitle[1]}</h2>
          <a class="button" href={bookUrl(property, unit, locale)} target="_blank" rel="noopener noreferrer">{t.bookNow}</a>
        </div>
      </section>

      <footer class="footer wrap">
        <div class="footer-top">
          <div class="brand">{wordmark}<span class="brand-dot">.</span></div>
          <p>{property.address}<br/>{property.city}, {property.country}{property.email && <><br/><a href={`mailto:${property.email}`}>{property.email}</a></>}</p>
        </div>
      </footer>
      <UnitLightbox units={unit ? [unit] : property.units} {locale} />
    </div>
  </body>
</html>
