---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import ApartmentCard from '../components/ApartmentCard.astro';
import { bookUrl, type Property, type PropertyUnit } from '../lib/property';
import { photoUrl } from '../lib/images';
import { strings, toLocale } from '../lib/i18n';

interface Props { property: Property; unit: PropertyUnit }
const { property, unit } = Astro.props;
const description = (unit.description ?? `${unit.name} — ${property.name}`).replace(/\s+/g, ' ').slice(0, 158);
const [cover, ...morePhotos] = unit.photos;
// Key facts lead; highlights follow, then amenities not already covered by a highlight ("Kitchen" vs "Equipped kitchen").
const keyFacts = [unit.areaSquareMetres && `${unit.areaSquareMetres} m²`, unit.occupancyLabel, ...unit.rooms.map(room => room.beds)].filter(Boolean);
const highlights = unit.highlights ?? [];
const features = [...new Set([...highlights, ...unit.amenities.filter(item => !highlights.some(h => h.toLowerCase().includes(item.toLowerCase())))])];
// Gallery shows photos in batches; "Load more" reveals the next batch.
const batch = 6;
const locale = toLocale(Astro.currentLocale);
const t = strings(locale);
const booking = bookUrl(property, unit, locale);
const otherUnits = property.units.filter(other => other.id !== unit.id);
---
<Layout title={`${unit.name} | ${property.name}`} {description} image={cover && await photoUrl(cover.url)} {property} {unit}>
  <div class="sticky-book" inert>
    <div class="wrap">
      <p class="sticky-book-name">{unit.name}</p>
      <ul class="sticky-book-facts">
        {unit.occupancyLabel && <li>{unit.occupancyLabel}</li>}
        {unit.areaSquareMetres && <li>{unit.areaSquareMetres} m²</li>}
      </ul>
      <a class="sticky-book-link" href="#arrival">{t.goodToKnow}</a>
      <a class="button" href={booking} target="_blank" rel="noopener noreferrer">{t.bookNow}</a>
    </div>
  </div>
  <script>
    // Show the sticky booking bar once the main Book now button has scrolled above the screen.
    const bar = document.querySelector<HTMLElement>('.sticky-book');
    const book = document.querySelector('.unit-book');
    if (bar && book) {
      new IntersectionObserver((entries) => {
        const entry = entries[0];
        if (!entry) return;
        const show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        bar.classList.toggle('show', show);
        bar.inert = !show;
      }).observe(book);
    }
  </script>
  <div class="unit-fold">
  <div class="unit-stage wrap">
  {cover && (
    <figure class="unit-cover">
      <button type="button" data-unit-index="0" data-unit-photo-index="0" aria-label={t.viewPhotos(unit.name)}>
        <Photo photo={cover} sizes="(max-width: 700px) 92vw, 90vw" fallbackAlt={unit.name} eager />
      </button>
    </figure>
  )}

  <div class="unit-side">
    <h1 id="unit-title">{unit.name}</h1>
    {unit.setting && <p class="unit-setting">{unit.setting}</p>}
    {keyFacts.length > 0 && <ul class="unit-key">{keyFacts.map(fact => <li>{fact}</li>)}</ul>}
    <a class="button unit-book" href={booking} target="_blank" rel="noopener noreferrer">{t.bookNow}</a>
    {features.length > 0 && <ul class="unit-features">{features.map(fact => <li>{fact}</li>)}</ul>}
  </div>
  </div>
  </div>

  {morePhotos.length > 0 && (
    <section class="detail-gallery wrap" aria-label={t.morePhotos(unit.name)}>
      <div class="detail-grid">
        {morePhotos.map((photo, index) => (
          <button type="button" data-unit-index="0" data-unit-photo-index={index + 1} aria-label={t.viewPhoto(index + 2, unit.name)} hidden={index >= batch}>
            <Photo {photo} sizes="(max-width: 600px) 46vw, 30vw" fallbackAlt={unit.name} />
          </button>
        ))}
      </div>
      {morePhotos.length > batch && <button class="load-more" type="button" data-batch={batch}>{t.loadMore}</button>}
    </section>
  )}
  <script>
    // Reveal the next batch of gallery photos; focus the first new one so keyboard users continue from there.
    const more = document.querySelector<HTMLButtonElement>('.load-more');
    more?.addEventListener('click', () => {
      const hidden = [...document.querySelectorAll<HTMLElement>('.detail-grid > [hidden]')];
      const next = hidden.slice(0, Number(more.dataset.batch));
      next.forEach((item) => { item.hidden = false; });
      next[0]?.focus();
      if (hidden.length <= next.length) more.remove();
    });
  </script>

  {otherUnits.length > 0 && (
    <section class="spaces wrap" slot="after-practical" aria-labelledby="other-spaces-title">
      <div class="section-heading">
        <div><h2 id="other-spaces-title">{t.otherTitle[0]}<br/>{t.otherTitle[1]}</h2></div>
      </div>
      <div class="apartment-grid lead-4">
        {otherUnits.map((other, index) => <ApartmentCard unit={other} {locale} lead={index < 4} />)}
      </div>
    </section>
  )}
</Layout>
