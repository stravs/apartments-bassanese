---
import Layout from '../layouts/Layout.astro';
import ApartmentCard from '../components/ApartmentCard.astro';
import { Image, Picture } from 'astro:assets';
import { bookUrl, getProperty, mapEmbedUrl, mapsUrl, summary, unitPath } from '../lib/property';
import { accommodation, lodgingBusiness } from '../lib/structured-data';
import { localePath, strings, toLocale } from '../lib/i18n';
// Unsplash License photo; source in src/assets/images/stock/SOURCES.md.
import heroImage from '../assets/images/stock/lake-bled-island.jpg';
import { photoSource, photoUrl } from '../lib/images';
const exteriorImage = photoSource('/images/apartments-bassanese/521910555.webp');

const locale = toLocale(Astro.currentLocale);
const t = strings(locale);
const property = await getProperty(locale);
const story = property.narrative;
const google = property.googleRating;
const booking = property.bookingRating;
const testimonials = property.testimonials ?? [];
const score = (value: number) => value.toLocaleString(t.htmlLang, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
// Rows of three; a remainder becomes larger cards in the last row so no row is left short.
const unitCount = property.units.length;
const leadCount = [0, 4, 2][unitCount % 3] ?? 0;
const mapSrc = mapEmbedUrl(property, locale);
const address = [[property.address, property.city].filter(Boolean).join(' '), property.country].filter(Boolean).join(', ');

// Icons follow amenity order (lake, grocery, parking, garden); any further amenity reuses the last one.
const amenityIcons = [
  'M3 11l5-6 4 4 3-3 6 5M2 16c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2M2 20c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2',
  'M5 8h14l-1 13H6L5 8zm4 0V6a3 3 0 0 1 6 0v2',
  'M6 21V3h7a5 5 0 0 1 0 10H6',
  'M12 21V9m0 5c-7 0-8-7-8-7 7 0 8 4 8 7zm0 3c7 0 8-7 8-7-7 0-8 4-8 7z',
];

const location = [property.city, property.country].filter(Boolean).join(', ');
const description = summary(`${property.name}${location ? ` — ${location}` : ''}. ${property.description}`);
const homeUrl = new URL(localePath(locale, '/'), Astro.site).href;
const propertyImages = await Promise.all(property.photos.map((photo) => photoUrl(photo.url)));
// Home lists each apartment with its cover only; the apartment's own page carries all its photos.
const units = await Promise.all(property.units.map(async (unit) => accommodation(
  unit,
  new URL(localePath(locale, unitPath(unit.id)), Astro.site).href,
  unit.photos[0] ? [new URL(await photoUrl(unit.photos[0].url), Astro.site).href] : [],
)));
const jsonLd = { '@context': 'https://schema.org', ...lodgingBusiness(property, locale, homeUrl, propertyImages.map(src => new URL(src, Astro.site).href), units) };
---
<Layout title={`${property.name} | ${property.city ?? t.accommodation}`} {description} image={propertyImages[0]} {jsonLd} {property}>
  <div class="fold">
  <section class="hero" aria-labelledby="hero-title">
    {/* LCP image: AVIF first (about half the bytes of WebP). Phones show a zoomed crop (see .hero-photo img);
        sizes asks for ~one screen height so a 3× phone gets the 2560px file, not the 3200px one. */}
    <Picture src={heroImage} formats={['avif']} fallbackFormat="webp" widths={[768, 1280, 1920, 2560, 3200]} sizes="(max-width: 600px) 100vh, max(100vw, 120vh)" alt={t.heroAlt} priority pictureAttributes={{ class: 'hero-photo' }} />
    <div class="hero-content wrap">
      <div>
        <h1 id="hero-title">{story.heroTitle}</h1>
        <p>{story.introText}</p>
        <div class="hero-actions">
          <a class="button" href={bookUrl(property, undefined, locale)} target="_blank" rel="noopener noreferrer">{t.bookNow}</a>
          {(google || booking) && (
            <div class="hero-ratings">
              {booking && (
                <a class="hero-rating" href={booking.url} target="_blank" rel="noopener noreferrer">
                  <strong class="score-badge">{score(booking.value)}</strong>
                  <span>{t.bookingReviews(booking.count)}</span>
                </a>
              )}
              {google && (
                <a class="hero-rating" href={google.url} target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" fill="currentColor" /></svg>
                  <strong>{score(google.value)}</strong>
                  <span>{t.googleReviews(google.count)}</span>
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <div class="amenities" aria-label={t.propertyHighlights}>
    {property.amenities.map((amenity, index) => (
      <div>
        <p>{amenity}</p>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={amenityIcons[index] ?? amenityIcons.at(-1)} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </div>
    ))}
  </div>
  </div>

  <section class="spaces wrap" id="apartments" aria-labelledby="spaces-title">
    <div class="section-heading">
      <div><h2 id="spaces-title">{t.exploreTitle[0]}<br/>{t.exploreTitle[1]}</h2></div>
      {story.spacesText && <div class="section-text">{story.spacesText.split('\n').map(line => <p>{line}</p>)}</div>}
    </div>
    <div class:list={['apartment-grid', leadCount && `lead-${leadCount}`, unitCount % 2 === 1 && 'odd']}>
      {property.units.map((unit, index) => <ApartmentCard {unit} {locale} lead={index >= unitCount - leadCount} />)}
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="reviews" id="reviews" aria-labelledby="reviews-title">
      <div class="wrap">
      <div class="section-heading">
        <div><h2 id="reviews-title">{t.reviewsTitle[0]}<br/>{t.reviewsTitle[1]}</h2></div>
        <div class="review-scores">
          {booking && <a href={booking.url} target="_blank" rel="noopener noreferrer"><strong>{score(booking.value)}</strong><span>/10</span><small>{t.bookingReviews(booking.count)}</small></a>}
          {google && <a href={google.url} target="_blank" rel="noopener noreferrer"><strong>{score(google.value)}</strong><span>/5</span><small>{t.googleReviews(google.count)}</small></a>}
        </div>
      </div>
      <div class="review-grid">
        {testimonials.map((review) => (
          <figure class="review">
            {/* Quotes are verbatim, in the guest's language (English). */}
            <blockquote lang="en"><p>“{review.quote}”</p></blockquote>
            <figcaption>
              <span>{[review.author, review.country].filter(Boolean).join(', ')}</span>
              <a href={review.url} target="_blank" rel="noopener noreferrer">{review.source}</a>
            </figcaption>
          </figure>
        ))}
      </div>
      </div>
    </section>
  )}

  <section class="setting" id="place" aria-labelledby="setting-title">
    <div class="wrap setting-grid">
      <div class="setting-copy">
        <h2 id="setting-title">{story.settingTitle ?? t.location}</h2>
        {story.settingText && <p>{story.settingText}</p>}
        {address && <address><a href={mapsUrl(property)} target="_blank" rel="noopener noreferrer">{address}</a></address>}
        <div class="setting-photo"><Image src={exteriorImage} widths={[480, 768, exteriorImage.width]} sizes="(max-width: 700px) 116vw, 57vw" alt={t.exteriorAlt} loading="lazy" /></div>
      </div>
      <iframe class="setting-map" data-src={mapSrc} title={t.mapTitle(property.name)} referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>
  </section>
  <script>
    // Google Maps pulls ~15 requests; the browser's own lazy loading starts them with the first screen on desktop.
    // Load the map only when it is about to scroll into view.
    const map = document.querySelector<HTMLIFrameElement>('.setting-map');
    if (map?.dataset.src) {
      const observer = new IntersectionObserver(([entry]) => {
        if (!entry?.isIntersecting) return;
        map.src = map.dataset.src ?? '';
        observer.disconnect();
      }, { rootMargin: '300px 0px' });
      observer.observe(map);
    }
  </script>
</Layout>
