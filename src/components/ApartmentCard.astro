---
import Photo from './Photo.astro';
import { unitPath, type PropertyUnit } from '../lib/property';
import { localePath, strings, type Locale } from '../lib/i18n';

interface Props { unit: PropertyUnit; locale: Locale; /** Larger card in a short last row. */ lead?: boolean }
const { unit, locale, lead = false } = Astro.props;
const cover = unit.photos[0];
const href = localePath(locale, unitPath(unit.id));
const facts = [
  unit.areaSquareMetres && `${unit.areaSquareMetres} m²`,
  unit.occupancyLabel,
  unit.rooms[0]?.beds,
].filter(Boolean);
---
<article class="apartment" id={`unit-${unit.id}`}>
  {/* Photo repeats the title link; hidden from keyboard and screen readers so the unit is announced once. */}
  <a class="card-image" {href} tabindex="-1" aria-hidden="true">
    {cover
      ? <Photo photo={cover} sizes={lead ? '(max-width: 800px) 92vw, 46vw' : '(max-width: 600px) 92vw, (max-width: 800px) 46vw, 30vw'} fallbackAlt={unit.name} />
      : <div class="placeholder">{strings(locale).photosSoon}</div>}
  </a>
  <div class="card-body">
    <h3><a {href}>{unit.name}</a></h3>
    {unit.setting && <p class="card-setting">{unit.setting}</p>}
    {facts.length > 0 && <ul class="card-facts">{facts.map(fact => <li>{fact}</li>)}</ul>}
  </div>
</article>
