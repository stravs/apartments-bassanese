---
import { Image } from 'astro:assets';
import { photoSource } from '../lib/images';
import type { PropertyPhoto } from '../lib/property';

interface Props {
  photo: PropertyPhoto;
  sizes: string;
  /** Used when the photo has no alt text of its own. */
  fallbackAlt?: string;
  /** Above-the-fold photo: load immediately with high priority. */
  eager?: boolean;
}
const { photo, sizes, fallbackAlt, eager = false } = Astro.props;
const src = photoSource(photo.url);
// Steps between small and full size, so retina screens get a photo that fits instead of the 2400px original.
const widths = [...[480, 768, 1080, 1440, 1920].filter(w => w < src.width), src.width];
---
<Image {src} {widths} sizes={sizes} alt={photo.alt ?? fallbackAlt ?? ''} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
