---
import { photoUrl } from '../lib/images';
import type { PropertyUnit } from '../lib/property';
interface Props { units: PropertyUnit[] }
const { units } = Astro.props;
const unitGalleries = await Promise.all(units.map((unit) => Promise.all(unit.photos.map(async (photo) => ({ url: await photoUrl(photo.url), alt: photo.alt })))));
---
<dialog class="lightbox" id="unit-lightbox" aria-label="Accommodation unit photos">
  <div class="lightbox-bar"><p><span id="lightbox-unit"></span> · <strong id="lightbox-current">1</strong> / <span id="lightbox-total">1</span></p><button class="lightbox-close" type="button" aria-label="Close gallery">×</button></div>
  <div class="lightbox-stage"><button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous photo">‹</button><figure><img id="lightbox-image" alt="" /><figcaption id="lightbox-caption"></figcaption></figure><button class="lightbox-nav lightbox-next" type="button" aria-label="Next photo">›</button></div>
</dialog>
<script is:inline define:vars={{ unitGalleries, unitNames: units.map((unit) => unit.name), photoLabel: 'Photo' }}>
  const dialog = document.querySelector('#unit-lightbox');
  const lightboxImage = document.querySelector('#lightbox-image');
  const lightboxCaption = document.querySelector('#lightbox-caption');
  const lightboxCurrent = document.querySelector('#lightbox-current');
  const lightboxTotal = document.querySelector('#lightbox-total');
  const lightboxUnit = document.querySelector('#lightbox-unit');
  let activeUnit = 0; let activePhoto = 0; let touchStartX = 0;
  function showPhoto(index) { const gallery = unitGalleries[activeUnit]; activePhoto = (index + gallery.length) % gallery.length; const photo = gallery[activePhoto]; lightboxImage.src = photo.url; lightboxImage.alt = photo.alt || `${photoLabel} ${activePhoto + 1}`; lightboxCaption.textContent = photo.alt || ''; lightboxCurrent.textContent = String(activePhoto + 1); }
  document.querySelectorAll('[data-unit-photo-index]').forEach((button) => button.addEventListener('click', () => { activeUnit = Number(button.dataset.unitIndex); lightboxUnit.textContent = unitNames[activeUnit]; lightboxTotal.textContent = String(unitGalleries[activeUnit].length); showPhoto(Number(button.dataset.unitPhotoIndex)); dialog.showModal(); document.body.classList.add('lightbox-open'); }));
  document.querySelector('.lightbox-close').addEventListener('click', () => dialog.close());
  document.querySelector('.lightbox-prev').addEventListener('click', () => showPhoto(activePhoto - 1));
  document.querySelector('.lightbox-next').addEventListener('click', () => showPhoto(activePhoto + 1));
  dialog.addEventListener('close', () => document.body.classList.remove('lightbox-open'));
  dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  dialog.addEventListener('keydown', (event) => { if (event.key === 'ArrowLeft') showPhoto(activePhoto - 1); if (event.key === 'ArrowRight') showPhoto(activePhoto + 1); });
  dialog.addEventListener('touchstart', (event) => { touchStartX = event.changedTouches[0].clientX; }, { passive: true });
  dialog.addEventListener('touchend', (event) => { const distance = event.changedTouches[0].clientX - touchStartX; if (Math.abs(distance) > 50) showPhoto(activePhoto + (distance < 0 ? 1 : -1)); }, { passive: true });
</script>
<style>
  .lightbox { width: 100vw; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 0; border: 0; background: #141a16; color: white; }
  .lightbox::backdrop { background: #141a16; }
  .lightbox[open] { display: grid; grid-template-rows: auto minmax(0, 1fr); }
  .lightbox button:focus-visible { outline-color: #fff; outline-offset: -5px; }
  .lightbox-bar { height: 68px; padding: 0 22px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255, 255, 255, .14); }
  .lightbox-bar p { margin: 0; font-size: .85rem; color: #cdd2ce; }
  .lightbox-close, .lightbox-nav { border: 0; background: transparent; color: white; cursor: pointer; }
  .lightbox-close { width: 44px; height: 44px; font-size: 2rem; line-height: 1; }
  .lightbox-stage { min-height: 0; display: grid; grid-template-columns: 72px minmax(0, 1fr) 72px; align-items: stretch; }
  .lightbox-stage figure { min-width: 0; min-height: 0; margin: 0; padding: 24px; display: grid; grid-template-rows: minmax(0, 1fr) auto; gap: 14px; text-align: center; }
  .lightbox-stage img { width: 100%; height: 100%; min-height: 0; object-fit: contain; }
  .lightbox-stage figcaption { min-height: 24px; color: #d9ddda; font-size: .88rem; }
  .lightbox-nav { font-size: 3rem; transition: background .2s ease; }
  .lightbox-nav:hover, .lightbox-nav:focus-visible { background: rgba(255, 255, 255, .1); }
  :global(body.lightbox-open) { overflow: hidden; }

  @media (max-width: 600px) {
    .lightbox-bar { height: 58px; padding: 0 10px 0 16px; }
    .lightbox-stage { position: relative; display: block; }
    .lightbox-stage figure { height: 100%; padding: 12px 8px 22px; gap: 8px; }
    .lightbox-nav { position: absolute; z-index: 1; top: 50%; transform: translateY(-50%); width: 44px; height: 64px; background: rgba(0, 0, 0, .35); font-size: 2.5rem; }
    .lightbox-prev { left: 0; }
    .lightbox-next { right: 0; }
    .lightbox-stage figcaption { padding: 0 48px; font-size: .8rem; }
  }
</style>
